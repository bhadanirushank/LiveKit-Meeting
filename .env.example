# ==========================================
# LiveKit Meeting App - Environment Variables
# ==========================================

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password_placeholder
POSTGRES_DB=livekit_meeting
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PASSWORD=redis_password_placeholder
REDIS_HOST=redis
REDIS_PORT=6379

# --- LiveKit ---
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
# NOTE: In staging/production, use securely generated random strings for LIVEKIT_API_KEY and LIVEKIT_API_SECRET

# --- Backend API ---
JWT_SECRET=jwt_secret_placeholder
JWT_ISSUER=livekit-meeting-app
JWT_AUDIENCE=livekit-meeting-app
JWT_REALM=MeetingApp

# --- LiveKit Webhooks ---
# URL where LiveKit will send webhook events. For local dev, this might be a host.docker.internal URL or similar if using ngrok.
LIVEKIT_WEBHOOK_URL=http://backend:8080/api/v1/webhooks/livekit
